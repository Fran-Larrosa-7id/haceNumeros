{
  "name": "hace-numeros",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --test scripts/*.test.mjs && ng test",
    "data:rent:build": "node scripts/update-rent-indexes.mjs",
    "data:rent:validate": "node scripts/validate-rent-indexes.mjs",
    "data:rent:status": "node scripts/validate-rent-indexes.mjs --status",
    "data:rent:test": "node --test scripts/*.test.mjs",
    "data:salary:build": "node scripts/update-salary-parameters.mjs",
    "data:salary:validate": "node scripts/validate-salary-parameters.mjs",
    "data:salary:status": "node scripts/validate-salary-parameters.mjs --status",
    "data:validate": "npm run data:rent:validate && npm run data:salary:validate",
    "validate:dist": "node scripts/validate-dist.mjs",
    "serve:ssr:haceNumeros": "node dist/haceNumeros/server/server.mjs",
    "prod": "ng build --configuration production"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.1",
    "air-datepicker": "^3.6.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
